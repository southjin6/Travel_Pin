# Copy this file to .env (same folder) and fill in your own values.
# .env is listed in .gitignore, so real keys never get committed.

# REST Countries v5 — free key from https://restcountries.com/sign-up
# Without it the app runs on the public demo key, which returns one sample
# country for every lookup.
RESTCOUNTRIES_API_KEY=

# REQUIRED. Signs the session cookie, which is what a login *is* — so the app
# refuses to start without it rather than fall back to a shared default anyone
# could use to forge an admin's cookie. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Needed once, for the very first run, to create the administrator account:
# the account that resets passwords for everyone else. Change the username if
# you like. Once the account exists these two are never read again — empty them.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional. Set to 1 when the app is served over HTTPS so the cookie is
# encrypted in transit and refused over plain http (leave unset on localhost).
SESSION_COOKIE_SECURE=

# Optional. Use a different SQLite file — mainly so the schema migration can be
# rehearsed on a copy instead of the real travel.db.
TRAVEL_DB=
